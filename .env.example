# Скопируйте этот файл в .env и впишите значения.
# .env в .gitignore — секреты в репозиторий не попадают.

# ── Обязательное ────────────────────────────────────────────────────────────
# Токен бота от @BotFather.
BOT_TOKEN=

# ── Mini App ────────────────────────────────────────────────────────────────
# Базовый HTTPS-адрес, по которому раздаётся каталог webapp/ (например, Caddy).
# Без него бот работает в fallback-режиме: вопросы и статистика прямо в чате.
# Пример: WEBAPP_BASE=https://interview-trainer.example.org
WEBAPP_BASE=

# Точечные переопределения, если страницы лежат по нестандартным путям.
# WEBAPP_HOME_URL=
# WEBAPP_QUIZ_URL=
# WEBAPP_MOCK_URL=
# WEBAPP_ROADMAP_URL=

# ── Sync API ────────────────────────────────────────────────────────────────
# true — бот сообщает, что синхронизация включена; сам API поднимается отдельно.
SYNC_ENABLED=true

# Путь к файлу SQLite сервиса синхронизации.
DATABASE_PATH=api/state.db

# Разрешённый CORS-origin (тот же домен, что и Mini App).
# За reverse-proxy (same-origin) можно не задавать — заголовки CORS не шлются.
API_CORS_ORIGIN=

# Лимит запросов к API на пользователя: скользящее окно.
# 0 в любом из двух параметров отключает лимит. Превышение → HTTP 429.
API_RATE_MAX=60
API_RATE_WINDOW=60

# Максимальный возраст Telegram initData в секундах (защита от replay).
API_INITDATA_MAX_AGE=86400

# ── Прочее ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
